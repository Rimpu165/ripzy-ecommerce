DATABASE_URL="file:./dev.db"
JWT_SECRET="generate-with: openssl rand -hex 32"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Razorpay (leave empty to use simulated test checkout)
RAZORPAY_KEY_ID=""
