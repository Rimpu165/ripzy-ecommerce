# Email (optional; without SMTP, emails are logged to the notifications table)
SMTP_HOST=""
SMTP_FROM="Ripzy <no-reply@ripzy.com>"
# Protects /api/cron/* jobs (abandoned carts, back-in-stock)
CRON_SECRET="change-me"
